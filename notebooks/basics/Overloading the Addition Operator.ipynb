   "source": [
    "class Vector:\n",
    "    def __init__(self, x):\n",
    "        self.x = x\n",
    "\n",
    "    def __add__(self, other):\n",
    "        return Vector(self.x + other.x)\n",
    "\n",
    "v1 = Vector(5)\n",
    "v2 = Vector(7)\n",
    "v3 = v1 + v2\n",
    "\n",
    "print(v3.x)  # Output: 12"
   ]
