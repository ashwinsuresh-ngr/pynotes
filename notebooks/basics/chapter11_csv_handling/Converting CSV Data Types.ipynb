    "import csv\n",
    "\n",
    "with open(\"data.csv\", \"r\") as file:\n",
    "    reader = csv.DictReader(file)\n",
    "    for row in reader:\n",
    "        age = int(row[\"age\"])\n",
    "        salary = float(row[\"salary\"])\n",
    "        print(age, salary)"
