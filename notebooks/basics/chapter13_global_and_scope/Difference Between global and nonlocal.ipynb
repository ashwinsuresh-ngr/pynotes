    "x = 50\n",
    "\n",
    "def outer():\n",
    "    x = 10\n",
    "    \n",
    "    def inner():\n",
    "        global x\n",
    "        x = 99\n",
    "\n",
    "    inner()\n",
    "    print(\"Outer x:\", x)\n",
    "\n",
    "outer()\n",
    "print(\"Global x:\", x)"
