    "import csv\n",
    "\n",
    "fieldnames = [\"name\", \"age\", \"city\"]\n",
    "\n",
    "with open(\"users.csv\", \"w\", newline=\"\") as file:\n",
    "    writer = csv.DictWriter(file, fieldnames=fieldnames)\n",
    "    writer.writeheader()\n",
    "    writer.writerow({\"name\": \"Alice\", \"age\": 25, \"city\": \"Paris\"})"
