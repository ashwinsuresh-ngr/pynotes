    "class FileMissingError(Exception):\n",
    "    pass\n",
    "\n",
    "def load_config(filename):\n",
    "    if not filename.endswith(\".json\"):\n",
    "        raise FileMissingError(\"Only JSON configuration files supported\")\n",
    "\n",
    "load_config(\"config.txt\")"
   ]
